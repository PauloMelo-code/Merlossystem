# Template de ambiente do MerlostoreChat.
#
# Gerado a partir de src/lib/env.ts, que e a dona da verdade: toda chave daqui
# existe la, validada com Zod, e o boot LANCA quando falta alguma obrigatoria do
# ambiente. Chave nova entra primeiro em env.ts, depois aqui (trava T17).
#
# Copie para .env e preencha. Nunca versione o .env, nunca escreva segredo real
# neste arquivo. Segredo dedicado: 32 bytes ou mais, diferente em HML e PRD
# (gere com `openssl rand -base64 48`).
#
# PROXIES_CONFIAVEIS NAO e variavel de ambiente: e constante versionada em
# src/lib/seguranca/ip.ts (02-seguranca.md §7.3).

# -- Ambiente -----------------------------------------------------------------
# development | test | production (HML tambem roda como production)
NODE_ENV=development
# Unica fonte de baseURL, trustedOrigins, rpID e link de e-mail
APP_URL=http://localhost:3005
PORT=3005

# -- Banco --------------------------------------------------------------------
# Papel merlo_app (nunca dono das tabelas)
DATABASE_URL=postgres://dev:dev@localhost:5437/merlostore_dev
# Papel merlo_migracao. So migrate.ts, db-backup.mjs e db-teste.mjs.
# Obrigatoria em HML e PRD.
DATABASE_URL_MIGRACAO=
# So tests/integracao. Obrigatoria quando NODE_ENV=test.
DATABASE_URL_TESTE=postgres://dev:dev@localhost:5437/merlostore_test
# app 10, worker 5
DB_POOL_MAX=10

# -- Redis / fila -------------------------------------------------------------
REDIS_URL=redis://localhost:6382
# attempts do BullMQ
FILA_TENTATIVAS=5
# teto do processo worker (a concorrencia por fila esta em 03-arquitetura.md §8.1)
WORKER_CONCORRENCIA=8

# -- Autenticacao (Better Auth) -----------------------------------------------
# Versionados, do mais novo para o mais velho: v2:<segredo>,v1:<segredo>
BETTER_AUTH_SECRETS=
# HMAC do e-mail em auth_eventos
AUTH_EMAIL_HASH_KEY=
# true | false
AUTH_PASSKEY_HABILITADA=true
AUTH_HIBP_HABILITADO=true
# Piso da recusa unica de login, em ms. Minimo 300, padrao 450.
# O valor de producao sai de `npm run medir-kdf` rodado na VPS.
PISO_RECUSA_MS=450
# Obrigatoria quando houver 2 ou mais instancias web
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# -- Integracoes: cofre e OAuth -----------------------------------------------
# Chave do cofre AES-256-GCM. Imutavel; girar exige o plano do runbook.
INTEGRATIONS_KEY=
# Assina o state do OAuth. Nunca reusar o segredo de auth.
INTEGRATIONS_STATE_KEY=
# O trio do Bling anda junto: com CLIENT_ID, os outros dois viram obrigatorios
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=

# -- Canais -------------------------------------------------------------------
# HMAC dos webhooks WhatsApp/Instagram/Messenger. Com ele, META_GRAPH_VERSION e obrigatoria.
# UM APP META POR AMBIENTE: o endereco do webhook e do app, nao da instalacao.
META_APP_SECRET=
# Formato v23.0. Sem default no codigo: versao cravada envelhece sem ninguem ver.
META_GRAPH_VERSION=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
# Challenge do webhook do Messenger. PROPRIO: nunca o do Instagram (ADR 0054).
FACEBOOK_VERIFY_TOKEN=
# App da TikTok API for Business (mensagem direta, ADR 0055). UM APP POR AMBIENTE:
# HML e PRD com o mesmo app disputam o endereco de entrega das mensagens.
# Com TIKTOK_APP_ID, TIKTOK_APP_SECRET e TIKTOK_API_VERSAO sao obrigatorias.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Formato v1.3. Sem default no codigo.
TIKTOK_API_VERSAO=
# O segredo do webhook uazapi e POR INTEGRACAO, no banco — nao entra aqui
UAZAPI_BASE_URL=

# -- Pagamentos (R2-B) ---------------------------------------------------------
# desligado | teste | producao. HML: teste. PRD: producao, so depois da conferencia do config.ts
PAGAMENTOS_MERCADOPAGO=desligado

# -- Midia (S3/MinIO) ---------------------------------------------------------
# Interno: app e worker
S3_ENDPOINT=http://localhost:9002
# So para URL assinada de provedor externo (caminho de excecao)
S3_ENDPOINT_PUBLICO=
S3_BUCKET=merlostore-midia
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# -- E-mail (convite, reset, avisos de seguranca) -----------------------------
# desligado | <nome do provedor>. PROVEDOR AINDA NAO ESCOLHIDO: o padrao e desligado.
# Desligado (ADR 0062), em qualquer ambiente:
#   - convite: o link aparece UMA vez para quem convidou, para entregar por canal seguro;
#   - senha esquecida: recuperacao assistida pelo administrador;
#   - avisos de conta: sino de dono/admin.
# O link e o token NUNCA vao para o log.
#
# Quando o provedor for escolhido (passo a passo no README, secao E-mail):
#   EMAIL_PROVEDOR   nome do provedor, igual ao `case` em src/server/processadores/emails.ts
#   EMAIL_REMETENTE  seguranca@<dominio>, dominio com SPF/DKIM/DMARC (p=quarantine)
#   EMAIL_API_KEY    chave do provedor, diferente em HML e PRD
# Com provedor, EMAIL_REMETENTE e EMAIL_API_KEY sao obrigatorias em HML e PRD.
EMAIL_PROVEDOR=desligado
EMAIL_REMETENTE=
EMAIL_API_KEY=

# -- Operacao -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_NIVEL=info
# por instancia
EVENTOS_MAX_CONEXOES=200
# 3 por pessoa; 2 para dono e admin
EVENTOS_MAX_POR_USUARIO=3
# /api/pronto: comparado com timingSafeEqual. Obrigatoria em HML e PRD.
SONDA_SEGREDO=
# Webhook do Discord da equipe (so o tipo do evento vai por la, nunca dado pessoal)
DISCORD_WEBHOOK_ALERTAS=
# Pesquisa de satisfacao automatica (true/false). Desligada ate o cliente aprovar o texto.
CSAT_ATIVO=false

# -- Inteligencia (R2-C) -------------------------------------------------------
# desligado | anthropic | simulado (simulado nunca em producao)
IA_PROVEDOR_TEXTO=desligado
# Chave da instalacao; so quando IA_PROVEDOR_TEXTO=anthropic
ANTHROPIC_API_KEY=
# desligado | openai | simulado (simulado nunca em producao)
IA_PROVEDOR_TRANSCRICAO=desligado
# So quando IA_PROVEDOR_TRANSCRICAO=openai
OPENAI_API_KEY=
# true/false. Manda texto da cliente a terceiro sem ninguem pedir: so com aprovacao do cliente
IA_CLASSIFICACAO_AUTOMATICA=false
# Limite de gasto por loja, por dia de Sao Paulo, em dolares
IA_LIMITE_DIARIO_USD=2.00
