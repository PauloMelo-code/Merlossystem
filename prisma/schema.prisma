generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL NAO entra aqui: o Prisma 7 removeu `url` da schema (P1012). Ela vem
  // de `prisma.config.ts`, que por isso precisa estar na imagem de producao
  // para o `prisma db push` saber onde e o banco.
}

// ============================================================
// LOJAS
// ============================================================

/// Unidade de negocio. Hoje: Centro e Cerro Azul.
/// Tudo que e operacional pertence a uma loja — ver docs/integracoes.md.
model Store {
  id              String  @id @default(uuid())
  nome            String
  slug            String  @unique // usado na URL de webhook e no seletor de loja
  ativo           Boolean @default(true)
  /// De-para com o Bling: a conta e unica da rede e a separacao la e por
  /// deposito (decisao 6 de docs/integracoes.md).
  blingDepositoId String? @map("bling_deposito_id")

  // Colunas de auditoria obrigatorias (CLAUDE.md). As tabelas legadas ainda
  // nao tem — estas nascem com.
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  modifiedBy String?   @map("modified_by")

  integracoes         StoreIntegracao[]
  users               User[]
  contacts            Contact[]
  conversations       Conversation[]
  messages            Message[]
  mediaFiles          MediaFile[]
  lookbooks           Lookbook[]
  products            Product[]
  deals               Deal[]
  orders              Order[]
  returns             Return[]
  alerts              Alert[]
  quickReplies        QuickReply[]
  whatsappTemplates   WhatsappTemplate[]
  scheduledMessages   ScheduledMessage[]
  broadcasts          Broadcast[]
  satisfactionSurveys SatisfactionSurvey[]
  knowledgeArticles   KnowledgeArticle[]
  consentLogs         ConsentLog[]
  activityLogs        ActivityLog[]

  @@map("stores")
}

/// Uma conta conectada de um provedor. NAO e "uma por provedor": a loja tem
/// varios numeros de WhatsApp, cada um vira uma linha (decisao 3 de
/// docs/integracoes.md).
model StoreIntegracao {
  id       String  @id @default(uuid())
  /// NULO = integracao da rede, nao de uma loja. Hoje so o Bling, que e conta
  /// unica com deposito por loja (decisao 6). Mesma convencao de users.store_id.
  storeId  String? @map("store_id")
  provedor String // bling | tiktok_shop | instagram | uazapi
  /// Nome que o operador ve: "WhatsApp Vendas Centro", "WhatsApp SAC Centro".
  /// Com varios numeros por loja, sem rotulo ninguem sabe qual e qual.
  rotulo   String
  status   String  @default("desconectado") // desconectado | conectado | expirado | erro

  /// Vendedora dona deste numero: a conversa que entra por ele ja nasce
  /// atribuida a ela. Nulo = numero da loja, sem dono (comportamento antigo).
  /// So faz sentido em canal de conversa; conta da rede (Bling) nunca tem.
  vendedorId String? @map("vendedor_id")

  /// AES-256-GCM (src/lib/cofre.ts). NUNCA em texto plano, NUNCA devolvido
  /// pela API — a tela recebe so o resumo mascarado.
  credenciaisCifradas String? @map("credenciais_cifradas")

  /// Identificador NAO-secreto da conta no provedor, e a chave de roteamento
  /// do webhook: numero/instancia (uazapi), id da conta (Instagram),
  /// shop id (TikTok Shop), id da empresa (Bling).
  referenciaExterna String @map("referencia_externa")

  expiraEm            DateTime? @map("expira_em")
  ultimoErro          String?   @map("ultimo_erro")
  ultimaSincronizacao DateTime? @map("ultima_sincronizacao")

  conversas   Conversation[]
  broadcasts  Broadcast[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  modifiedBy String?   @map("modified_by")

  store    Store? @relation(fields: [storeId], references: [id])
  vendedor User?  @relation("NumeroDaVendedora", fields: [vendedorId], references: [id])

  /// A mesma conta nao pode estar conectada em duas lojas ao mesmo tempo:
  /// a mensagem que chega nao teria dono definido.
  @@unique([provedor, referenciaExterna])
  @@index([vendedorId])
  @@index([storeId])
  /// Busca que roda em TODO webhook recebido.
  @@index([provedor, referenciaExterna])
  @@map("stores_integracoes")
}

// ============================================================
// USUÁRIOS E AUTENTICAÇÃO
// ============================================================

model User {
  id           String    @id @default(uuid())
  storeId      String?   @map("store_id")
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  /// admin | gerente | vendedor | viewer — ver docs/rbac.md.
  /// `admin` e `gerente` tem storeId nulo (alcancam as duas lojas);
  /// `vendedor` e `viewer` tem loja obrigatoria. A regra e garantida pela
  /// constraint users_loja_por_papel (prisma/sql/constraints.sql).
  role         String    @default("vendedor")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  assignedConversations Conversation[]     @relation("AssignedAgent")
  numerosProprios       StoreIntegracao[]  @relation("NumeroDaVendedora")
  sentMessages          Message[]          @relation("SenderAgent")
  uploadedMedia         MediaFile[]        @relation("Uploader")
  acknowledgedAlerts    Alert[]            @relation("AcknowledgedBy")
  createdOrders         Order[]            @relation("OrderCreator")
  resolvedReturns       Return[]           @relation("ReturnResolver")
  dealChanges           DealEvent[]        @relation("DealChanger")
  assignedDeals         Deal[]             @relation("DealAssignee")
  scheduledMessages     ScheduledMessage[] @relation("ScheduleCreator")
  createdBroadcasts     Broadcast[]        @relation("BroadcastCreator")
  knowledgeArticles     KnowledgeArticle[] @relation("ArticleAuthor")
  activityLogs          ActivityLog[]      @relation("LogUser")
  store                 Store?             @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("users")
}

// ============================================================
// CONTATOS (CLIENTES)
// ============================================================

model Contact {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  name          String?
  phone         String?
  email         String?
  instagramId   String?   @map("instagram_id")
  facebookId    String?   @map("facebook_id")
  tiktokId      String?   @map("tiktok_id")
  whatsappId    String?   @map("whatsapp_id")
  avatarUrl     String?   @map("avatar_url")
  preferredSize String?   @map("preferred_size") // slim | plussize | both
  tags          String[]  @default([])
  notes         String?
  totalOrders   Int       @default(0) @map("total_orders")
  totalSpent    Decimal   @default(0) @map("total_spent") @db.Decimal(10, 2)
  lastContactAt DateTime? @map("last_contact_at")
  birthday      DateTime? @db.Date
  address       Json?
  optOut        Boolean   @default(false) @map("opt_out")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")

  conversations       Conversation[]
  deals               Deal[]
  orders              Order[]
  returns             Return[]
  alerts              Alert[]              @relation("ContactAlerts")
  scheduledMessages   ScheduledMessage[]
  broadcastRecipients BroadcastRecipient[]
  satisfactionSurveys SatisfactionSurvey[]
  consentLogs         ConsentLog[]
  store               Store                @relation(fields: [storeId], references: [id])

  // Carteira isolada por loja (decisao 5 de docs/integracoes.md): o mesmo
  // telefone pode existir no Centro e no Cerro Azul como dois contatos, mas
  // nunca duas vezes na mesma loja. Antes disso nao havia unicidade nenhuma —
  // duas mensagens simultaneas do mesmo numero criavam dois contatos.
  @@unique([storeId, whatsappId])
  @@unique([storeId, instagramId])
  @@unique([storeId, facebookId])
  @@unique([storeId, tiktokId])
  @@unique([storeId, phone])
  @@index([storeId])
  @@map("contacts")
}

// ============================================================
// CONVERSAS
// ============================================================

model Conversation {
  id                    String    @id @default(uuid())
  storeId               String    @map("store_id")
  /// Por qual CONTA a conversa entrou — qual numero de WhatsApp, qual perfil
  /// do Instagram. A resposta sai por esta mesma conta.
  ///
  /// Nulo em conversa criada antes do roteamento por conta (etapa 3): nesse
  /// caso o envio cai no adapter configurado por ambiente.
  storeIntegracaoId     String?   @map("store_integracao_id")
  contactId             String    @map("contact_id")
  channel               String // whatsapp | instagram | facebook | tiktok
  channelConversationId String?   @map("channel_conversation_id")
  status                String    @default("open") // open | pending | resolved | archived
  assignedTo            String?   @map("assigned_to")
  lastMessageAt         DateTime? @map("last_message_at")
  lastMessagePreview    String?   @map("last_message_preview")
  unreadCount           Int       @default(0) @map("unread_count")
  priority              String    @default("medium") // low | medium | high | urgent
  slaDeadline           DateTime? @map("sla_deadline")
  slaBreached           Boolean   @default(false) @map("sla_breached")
  aiSummary             String?   @map("ai_summary")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  contact             Contact              @relation(fields: [contactId], references: [id])
  agent               User?                @relation("AssignedAgent", fields: [assignedTo], references: [id])
  messages            Message[]
  deals               Deal[]
  orders              Order[]
  returns             Return[]
  alerts              Alert[]              @relation("ConversationAlerts")
  scheduledMessages   ScheduledMessage[]
  satisfactionSurveys SatisfactionSurvey[]
  store               Store                @relation(fields: [storeId], references: [id])
  integracao          StoreIntegracao?     @relation(fields: [storeIntegracaoId], references: [id])

  @@index([storeId])
  @@index([storeIntegracaoId])
  @@map("conversations")
}

// ============================================================
// MENSAGENS
// ============================================================

model Message {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  conversationId   String    @map("conversation_id")
  senderType       String // customer | agent | bot | system
  senderId         String?   @map("sender_id")
  content          String?
  contentType      String    @default("text") @map("content_type")
  // text | image | video | audio | document | product | payment | location | sticker
  externalId       String?   @map("external_id")
  externalStatus   String?   @map("external_status") // sent | delivered | read | failed
  isInternalNote   Boolean   @default(false) @map("is_internal_note")
  replyToId        String?   @map("reply_to_id")
  metadata         Json      @default("{}")
  aiClassification Json?     @map("ai_classification")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  conversation Conversation   @relation(fields: [conversationId], references: [id])
  sender       User?          @relation("SenderAgent", fields: [senderId], references: [id])
  replyTo      Message?       @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]      @relation("MessageReplies")
  media        MessageMedia[]
  store        Store          @relation(fields: [storeId], references: [id])

  @@index([storeId])
  /// Idempotencia de webhook: o mesmo evento entregue duas vezes nao vira duas
  /// bolhas. Parcial (so external_id nao nulo) — ver prisma/sql/constraints.sql,
  /// que e o arquivo que realmente chega ao banco de producao.
  @@unique([storeId, externalId], name: "messages_store_external_id")
  @@map("messages")
}

// ============================================================
// GALERIA DE MÍDIA
// ============================================================

model MediaFile {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  originalName String?  @map("original_name")
  // Chave do objeto no bucket (ADR 0006). `fileUrl` e a rota interna
  // autenticada, nao a URL do bucket — o binario nunca e publico.
  fileKey      String   @map("file_key")
  fileUrl      String   @map("file_url")
  thumbnailKey String?  @map("thumbnail_key")
  thumbnailUrl String?  @map("thumbnail_url")
  fileType     String   @map("file_type") // image | video | audio | document
  mimeType     String?  @map("mime_type")
  fileSize     Int?     @map("file_size")
  width        Int?
  height       Int?
  duration     Int?
  productId    String?  @map("product_id")
  folder       String   @default("general") // produtos | lookbooks | stories | general
  tags         String[] @default([])
  uploadedBy   String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @default(now()) @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")

  product      Product?       @relation(fields: [productId], references: [id])
  uploader     User?          @relation("Uploader", fields: [uploadedBy], references: [id])
  messageMedia MessageMedia[]
  store        Store          @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("media_files")
}

model MessageMedia {
  id                  String   @id @default(uuid())
  messageId           String   @map("message_id")
  mediaFileId         String?  @map("media_file_id")
  externalUrl         String?  @map("external_url")
  externalId          String?  @map("external_id")
  fileType            String?  @map("file_type")
  mimeType            String?  @map("mime_type")
  fileSize            Int?     @map("file_size")
  caption             String?
  downloaded          Boolean  @default(false)
  transcription       String?
  transcriptionStatus String?  @map("transcription_status") // pending | processing | completed | failed
  createdAt           DateTime @default(now()) @map("created_at")

  message   Message    @relation(fields: [messageId], references: [id])
  mediaFile MediaFile? @relation(fields: [mediaFileId], references: [id])

  @@map("message_media")
}

model Lookbook {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  name         String
  description  String?
  coverMediaId String?  @map("cover_media_id")
  productIds   String[] @default([]) @map("product_ids")
  mediaIds     String[] @default([]) @map("media_ids")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @default(now()) @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")
  store        Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("lookbooks")
}

// ============================================================
// CATÁLOGO DE PRODUTOS
// ============================================================

model Product {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  name           String
  sku            String?
  description    String?
  category       String?
  // vestidos | blusas | calcas | saias | shorts | conjuntos | macacoes | jaquetas | acessorios
  sizeType       String   @default("both") @map("size_type") // slim | plussize | both
  sizes          String[] @default([])
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(10, 2)
  stock          Json     @default("{}") // {"P": 5, "M": 3, "G": 0, "48": 2}
  weightGrams    Int?     @map("weight_grams")
  imageUrls      String[] @default([]) @map("image_urls")
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  mediaFiles MediaFile[]
  store      Store       @relation(fields: [storeId], references: [id])

  @@unique([storeId, sku])
  @@index([storeId])
  @@map("products")
}

// ============================================================
// PIPELINE DE VENDAS (CRM)
// ============================================================

model Deal {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  contactId         String    @map("contact_id")
  conversationId    String?   @map("conversation_id")
  assignedTo        String?   @map("assigned_to")
  stage             String    @default("lead")
  // lead | interested | negotiating | closing | won | lost
  value             Decimal   @default(0) @db.Decimal(10, 2)
  products          Json      @default("[]")
  notes             String?
  lossReason        String?   @map("loss_reason")
  lossNotes         String?   @map("loss_notes")
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  /// Quando a classificacao automatica olhou este cartao pela ultima vez.
  /// E o marcador da fila: conversa com mensagem mais nova que isto volta a
  /// ser classificada. Coluna propria, e nao `last_activity_at`, porque aquele
  /// alimenta o alerta de "deal parado" — carimbar la esconderia justamente o
  /// cartao esquecido, que e o que o alerta existe para achar.
  aiEtapaEm         DateTime? @map("ai_etapa_em")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")

  contact      Contact       @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  assignee     User?         @relation("DealAssignee", fields: [assignedTo], references: [id])
  events       DealEvent[]
  orders       Order[]
  store        Store         @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("deals")
}

model DealEvent {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  fromStage String?  @map("from_stage")
  toStage   String?  @map("to_stage")
  changedBy String?  @map("changed_by")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  deal    Deal  @relation(fields: [dealId], references: [id])
  changer User? @relation("DealChanger", fields: [changedBy], references: [id])

  @@map("deal_events")
}

// ============================================================
// PEDIDOS
// ============================================================

model Order {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  contactId       String   @map("contact_id")
  dealId          String?  @map("deal_id")
  conversationId  String?  @map("conversation_id")
  orderNumber     String   @map("order_number")
  status          String   @default("confirmed")
  // confirmed | preparing | shipped | delivered | returned | cancelled
  items           Json
  subtotal        Decimal  @db.Decimal(10, 2)
  shippingCost    Decimal  @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  discount        Decimal  @default(0) @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  paymentMethod   String?  @map("payment_method") // pix | credit_card | boleto | link
  paymentStatus   String   @default("pending") @map("payment_status")
  shippingMethod  String?  @map("shipping_method")
  trackingCode    String?  @map("tracking_code")
  trackingUrl     String?  @map("tracking_url")
  shippingAddress Json?    @map("shipping_address")
  notes           String?

  // --- Ponte com o Masc (ADR 0004) --------------------------------------
  // O Masc e o dono da venda e este sistema nao escreve em ERP nenhum. Quem
  // fecha o ciclo e uma PESSOA lancando a venda no Masc — entao o pedido do
  // canal nasce PENDENTE e so sai da fila quando alguem anota o numero de la.
  // Sem isto, pedido de WhatsApp que ninguem lancou some sem deixar rastro.
  mascStatus     String    @default("pendente") @map("masc_status")
  // pendente | lancado | dispensado
  mascVendaId    String?   @map("masc_venda_id")
  mascLancadoEm  DateTime? @map("masc_lancado_em")
  mascLancadoPor String?   @map("masc_lancado_por")
  mascObservacao String?   @map("masc_observacao")

  createdBy       String?  @map("created_by")
  modifiedBy      String?  @map("modified_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contact             Contact              @relation(fields: [contactId], references: [id])
  deal                Deal?                @relation(fields: [dealId], references: [id])
  conversation        Conversation?        @relation(fields: [conversationId], references: [id])
  creator             User?                @relation("OrderCreator", fields: [createdBy], references: [id])
  events              OrderEvent[]
  payments            Payment[]
  returns             Return[]
  alerts              Alert[]              @relation("OrderAlerts")
  satisfactionSurveys SatisfactionSurvey[]
  store               Store                @relation(fields: [storeId], references: [id])

  @@unique([storeId, orderNumber])
  @@index([storeId])
  // A fila "o que falta lancar no Masc" e a consulta mais quente da ponte.
  @@index([storeId, mascStatus])
  @@map("orders")
}

model OrderEvent {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  status      String
  description String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_events")
}

// ============================================================
// PAGAMENTOS
// ============================================================

model Payment {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  provider        String // mercadopago | asaas | pagbank
  externalId      String?   @map("external_id")
  method          String // pix | credit_card | boleto | link
  status          String    @default("pending") // pending | approved | rejected | refunded | expired
  amount          Decimal   @db.Decimal(10, 2)
  pixQrcodeBase64 String?   @map("pix_qrcode_base64")
  pixCopyPaste    String?   @map("pix_copy_paste")
  paymentLink     String?   @map("payment_link")
  paidAt          DateTime? @map("paid_at")
  expiresAt       DateTime? @map("expires_at")
  refundedAt      DateTime? @map("refunded_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ============================================================
// TROCAS E DEVOLUÇÕES
// ============================================================

model Return {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  orderId        String    @map("order_id")
  contactId      String    @map("contact_id")
  conversationId String?   @map("conversation_id")
  type           String // exchange | return | refund
  reason         String // wrong_size | defect | not_as_expected | changed_mind | other
  reasonDetail   String?   @map("reason_detail")
  items          Json
  status         String    @default("requested")
  // requested | approved | shipping_back | received | completed | denied
  trackingCode   String?   @map("tracking_code")
  refundAmount   Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundMethod   String?   @map("refund_method")
  mediaIds       String[]  @default([]) @map("media_ids")
  resolvedBy     String?   @map("resolved_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  order        Order         @relation(fields: [orderId], references: [id])
  contact      Contact       @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  resolver     User?         @relation("ReturnResolver", fields: [resolvedBy], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("returns")
}

// ============================================================
// ALERTAS
// ============================================================

model Alert {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  type           String
  // sla_breach | hot_lead | review_risk | deal_stale | low_stock
  // first_contact | returning_customer | payment_pending | follow_up_due
  severity       String    @default("medium") // low | medium | high | critical
  conversationId String?   @map("conversation_id")
  contactId      String?   @map("contact_id")
  orderId        String?   @map("order_id")
  message        String
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation? @relation("ConversationAlerts", fields: [conversationId], references: [id])
  contact      Contact?      @relation("ContactAlerts", fields: [contactId], references: [id])
  order        Order?        @relation("OrderAlerts", fields: [orderId], references: [id])
  acknowledger User?         @relation("AcknowledgedBy", fields: [acknowledgedBy], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("alerts")
}

// ============================================================
// RESPOSTAS RÁPIDAS
// ============================================================

model QuickReply {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  title     String
  content   String
  category  String? // frete | medidas | troca | pagamento | rastreio | geral
  shortcut  String? // /frete, /medidas, /troca
  mediaIds  String[] @default([]) @map("media_ids")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @default(now()) @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, shortcut])
  @@index([storeId])
  @@map("quick_replies")
}

// ============================================================
// TEMPLATES DO WHATSAPP
// ============================================================

model WhatsappTemplate {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  name            String
  category        String // marketing | utility | authentication
  language        String    @default("pt_BR")
  headerType      String?   @map("header_type") // text | image | video | document
  headerContent   String?   @map("header_content")
  body            String
  footer          String?
  buttons         Json?
  metaTemplateId  String?   @map("meta_template_id")
  status          String    @default("draft") // draft | pending | approved | rejected
  rejectionReason String?   @map("rejection_reason")
  submittedAt     DateTime? @map("submitted_at")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @default(now()) @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")

  scheduledMessages ScheduledMessage[]
  broadcasts        Broadcast[]
  store             Store              @relation(fields: [storeId], references: [id])

  @@unique([storeId, name])
  @@index([storeId])
  @@map("whatsapp_templates")
}

// ============================================================
// MENSAGENS AGENDADAS
// ============================================================

model ScheduledMessage {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  conversationId String?   @map("conversation_id")
  contactId      String    @map("contact_id")
  content        String
  contentType    String    @default("text") @map("content_type")
  // text | template | product | media
  templateId     String?   @map("template_id")
  templateVars   String[]  @default([]) @map("template_vars")
  mediaIds       String[]  @default([]) @map("media_ids")
  scheduledFor   DateTime  @map("scheduled_for")
  triggerType    String    @map("trigger_type")
  // manual | follow_up | post_sale | abandoned | reactivation | birthday | promotion
  status         String    @default("scheduled") // scheduled | sent | cancelled | failed
  sentAt         DateTime? @map("sent_at")
  errorMessage   String?   @map("error_message")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation?     @relation(fields: [conversationId], references: [id])
  contact      Contact           @relation(fields: [contactId], references: [id])
  template     WhatsappTemplate? @relation(fields: [templateId], references: [id])
  creator      User?             @relation("ScheduleCreator", fields: [createdBy], references: [id])
  store        Store             @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("scheduled_messages")
}

// ============================================================
// BROADCAST / CAMPANHAS
// ============================================================

model Broadcast {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  name            String
  templateId      String    @map("template_id")
  channel         String    @default("whatsapp")
  /// Por qual CONTA a campanha sai — qual numero de WhatsApp.
  ///
  /// Sem isto o sistema teria que adivinhar entre as contas da loja, e numa
  /// loja com dois numeros (vendas e SAC) o disparo de marketing poderia sair
  /// pelo numero de atendimento. O projeto ja decidiu o contrario para as
  /// respostas (a conversa responde pela conta de entrada); campanha segue a
  /// mesma regra, so que a escolha e explicita na criacao.
  storeIntegracaoId String? @map("store_integracao_id")
  segmentFilter   Json      @map("segment_filter")
  content         String?
  mediaIds        String[]  @default([]) @map("media_ids")
  totalRecipients Int       @default(0) @map("total_recipients")
  sentCount       Int       @default(0) @map("sent_count")
  deliveredCount  Int       @default(0) @map("delivered_count")
  readCount       Int       @default(0) @map("read_count")
  repliedCount    Int       @default(0) @map("replied_count")
  failedCount     Int       @default(0) @map("failed_count")
  status          String    @default("draft")
  // draft | scheduled | sending | paused | completed | cancelled
  scheduledFor    DateTime? @map("scheduled_for")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @default(now()) @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")

  template   WhatsappTemplate     @relation(fields: [templateId], references: [id])
  integracao StoreIntegracao?     @relation(fields: [storeIntegracaoId], references: [id])
  creator    User?                @relation("BroadcastCreator", fields: [createdBy], references: [id])
  recipients BroadcastRecipient[]
  store      Store                @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id           String    @id @default(uuid())
  broadcastId  String    @map("broadcast_id")
  contactId    String    @map("contact_id")
  status       String    @default("pending")
  // pending | sending | sent | delivered | read | replied | failed
  //
  // `sending` e o estado entre RESERVAR a linha e receber a resposta do canal.
  // Sem ele, dois processamentos simultaneos pegariam o mesmo destinatario e a
  // cliente receberia a campanha duas vezes.
  externalId   String?   @map("external_id")
  sentAt       DateTime? @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  readAt       DateTime? @map("read_at")
  repliedAt    DateTime? @map("replied_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id])
  contact   Contact   @relation(fields: [contactId], references: [id])

  @@map("broadcast_recipients")
}

// ============================================================
// PESQUISA DE SATISFAÇÃO (CSAT)
// ============================================================

model SatisfactionSurvey {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  contactId      String    @map("contact_id")
  conversationId String?   @map("conversation_id")
  orderId        String?   @map("order_id")
  score          Int?
  feedback       String?
  triggerType    String    @map("trigger_type")
  // conversation_closed | order_delivered
  sentAt         DateTime? @map("sent_at")
  respondedAt    DateTime? @map("responded_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  contact      Contact       @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("satisfaction_surveys")
}

// ============================================================
// BASE DE CONHECIMENTO
// ============================================================

model KnowledgeArticle {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  title     String
  content   String
  category  String?
  // medidas | frete | troca | pagamento | tecidos | combinacoes | procedimentos
  tags      String[] @default([])
  isPublic  Boolean  @default(false) @map("is_public")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Soft delete (ADR 0005): excluir grava is_deleted, nunca apaga a linha.
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  modifiedBy    String?   @map("modified_by")

  author User? @relation("ArticleAuthor", fields: [createdBy], references: [id])
  store  Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("knowledge_articles")
}

// ============================================================
// LGPD — CONSENTIMENTO
// ============================================================

model ConsentLog {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  contactId String   @map("contact_id")
  type      String // data_processing | marketing | opt_out
  granted   Boolean
  channel   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("consent_logs")
}

// ============================================================
// LOG DE ATIVIDADES / AUDITORIA
// ============================================================

model ActivityLog {
  id         String   @id @default(uuid())
  /// Nulo em acao de REDE, que nao pertence a loja nenhuma: cadastrar um
  /// admin (que alcanca as duas lojas), conectar o Bling. Sem isto, as acoes
  /// mais sensiveis do sistema eram justamente as que nao cabiam na trilha.
  storeId    String?  @map("store_id")
  userId     String?  @map("user_id")
  action     String
  // message_sent | deal_moved | contact_updated | order_created
  // payment_generated | media_sent | template_submitted | broadcast_started | return_approved
  entityType String?  @map("entity_type")
  // message | deal | contact | order | payment | return | broadcast
  entityId   String?  @map("entity_id")
  details    Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user  User?  @relation("LogUser", fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("activity_logs")
}
